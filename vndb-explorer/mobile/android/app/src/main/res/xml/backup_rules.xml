<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Only personal data: "My lists", shelf settings and UI settings. The VNDB catalog
         (~170 MB) and the image cache are downloaded again; with them the backup would exceed
         Android's 25 MB limit and not happen at all. -->
    <include domain="file" path="vnshelf/user.sqlite" />
    <include domain="file" path="vnshelf/shelves.json" />
    <include domain="file" path="vnshelf/sources.json" />
    <include domain="root" path="app_webview/Default/Local Storage" />
</full-backup-content>
